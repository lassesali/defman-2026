(    TRIM\(SUBSTRING_INDEX\(ps.`remainder`, ',', 1\)\) AS `phase_token`,) Tj T*
(    SUBSTRING\(ps.`remainder`, CHAR_LENGTH\(SUBSTRING_INDEX\(ps.`remainder`, ',', 1\)\) + 2\) AS `rema) Tj T*
(    inder`) Tj T*
(  FROM `phase_splitter` ps) Tj T*
(  WHERE ps.`remainder` <> '') Tj T*
(\)) Tj T*
