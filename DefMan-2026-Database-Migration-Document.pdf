() Tj T*
(INSERT IGNORE INTO `products` \(`name`\)) Tj T*
(SELECT DISTINCT) Tj T*
(  COALESCE\(NULLIF\(TRIM\(r.`Product`\), ''\), 'Unknown Product'\)) Tj T*
(FROM `raport` r) Tj T*
(LEFT JOIN `products` p) Tj T*
(  ON p.`name` = COALESCE\(NULLIF\(TRIM\(r.`Product`\), ''\), 'Unknown Product'\)) Tj T*
(WHERE p.`id` IS NULL;) Tj T*
() Tj T*
(-- Backfill NULL `raport.product_id` by matching `raport.Product = products.name`) Tj T*
(UPDATE `raport` r) Tj T*
(INNER JOIN `products` p) Tj T*
(  ON p.`name` = COALESCE\(NULLIF\(TRIM\(r.`Product`\), ''\), 'Unknown Product'\)) Tj T*
(SET r.`product_id` = p.`id`) Tj T*
(WHERE r.`product_id` IS NULL;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 2. Extract distinct non-null `users.company` into `companies` & link `company_id`) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(INSERT IGNORE INTO `companies` \(`name`\)) Tj T*
(SELECT DISTINCT) Tj T*
(  TRIM\(u.`company`\)) Tj T*
(FROM `users` u) Tj T*
(WHERE u.`company` IS NOT NULL) Tj T*
(  AND TRIM\(u.`company`\) <> '';) Tj T*
() Tj T*
(UPDATE `users` u) Tj T*
(INNER JOIN `companies` c) Tj T*
(  ON c.`name` = TRIM\(u.`company`\)) Tj T*
(SET u.`company_id` = c.`id`) Tj T*
(WHERE u.`company` IS NOT NULL) Tj T*
(  AND TRIM\(u.`company`\) <> '';) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 3. Migrate active non-null `reset_token_hash` rows from `users` to `password_resets`) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(INSERT IGNORE INTO `password_resets` \(`user_id`, `token_hash`, `expires_at`, `created_at`\)) Tj T*
(SELECT) Tj T*
(  u.`id`,) Tj T*
(  u.`reset_token_hash`,) Tj T*
(  COALESCE\(u.`reset_token_expires_at`, DATE_ADD\(NOW\(\), INTERVAL 1 HOUR\)\),) Tj T*
(  u.`updated_at`) Tj T*
(FROM `users` u) Tj T*
(WHERE u.`reset_token_hash` IS NOT NULL) Tj T*
(  AND TRIM\(u.`reset_token_hash`\) <> '') Tj T*
(  AND \(u.`reset_token_expires_at` IS NULL OR u.`reset_token_expires_at` > NOW\(\)\);) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 4. Migrate `raport` -> `defect_reports`) Tj T*
(--    - Converts `Whenreported` VARCHAR\(32\) to DATETIME `reported_at` via STR_TO_DATE\(\)) Tj T*
(--    - Normalizes reporter identity \(`reporter_user_id` vs `guest_name`/`guest_email`\)) Tj T*
(--    - Standardizes `Priority` \('m_urgent' -> 'most_urgent', 'l_urgent' -> 'less_urgent'\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(INSERT INTO `defect_reports` \() Tj T*
(  `id`,) Tj T*
