(-- Add `company_id` to `users` if migrating in-place from legacy `users`) Tj T*
(SET @col_exists := \() Tj T*
(  SELECT COUNT\(*\)) Tj T*
(  FROM INFORMATION_SCHEMA.COLUMNS) Tj T*
(  WHERE TABLE_SCHEMA = DATABASE\(\)) Tj T*
(    AND TABLE_NAME = 'users') Tj T*
(    AND COLUMN_NAME = 'company_id') Tj T*
(\);) Tj T*
(SET @sql_add_company_id := IF\() Tj T*
(  @col_exists = 0,) Tj T*
(  'ALTER TABLE `users` ADD COLUMN `company_id` SMALLINT UNSIGNED NULL DEFAULT NULL AFTER `userle) Tj T*
(    vel`, ADD KEY `idx_users_company_id` \(`company_id`\), ADD CONSTRAINT `fk_users_company` FOREI) Tj T*
(    GN KEY \(`company_id`\) REFERENCES `companies` \(`id`\) ON DELETE SET NULL ON UPDATE CASCADE',) Tj T*
(  'SELECT 1') Tj T*
(\);) Tj T*
(PREPARE stmt FROM @sql_add_company_id;) Tj T*
(EXECUTE stmt;) Tj T*
(DEALLOCATE PREPARE stmt;) Tj T*
() Tj T*
