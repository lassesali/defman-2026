(  ps.`phase_token`) Tj T*
(FROM `phase_splitter` ps) Tj T*
(WHERE ps.`phase_token` <> '';) Tj T*
() Tj T*
(INSERT IGNORE INTO `analysis_phases` \(`report_id`, `phase_id`\)) Tj T*
(WITH RECURSIVE `phase_splitter` \(`report_id`, `phase_token`, `remainder`\) AS \() Tj T*
(  SELECT) Tj T*
(    a.`id` AS `report_id`,) Tj T*
(    TRIM\(SUBSTRING_INDEX\(a.`phase`, ',', 1\)\) AS `phase_token`,) Tj T*
(    SUBSTRING\(a.`phase`, CHAR_LENGTH\(SUBSTRING_INDEX\(a.`phase`, ',', 1\)\) + 2\) AS `remainder`) Tj T*
(  FROM `analyse` a) Tj T*
(  INNER JOIN `defect_analyses` da) Tj T*
(    ON da.`report_id` = a.`id`) Tj T*
(  WHERE a.`phase` IS NOT NULL) Tj T*
(    AND TRIM\(a.`phase`\) <> '') Tj T*
(  UNION ALL) Tj T*
(  SELECT) Tj T*
(    ps.`report_id`,) Tj T*
(    TRIM\(SUBSTRING_INDEX\(ps.`remainder`, ',', 1\)\) AS `phase_token`,) Tj T*
(    SUBSTRING\(ps.`remainder`, CHAR_LENGTH\(SUBSTRING_INDEX\(ps.`remainder`, ',', 1\)\) + 2\) AS `rema) Tj T*
(    inder`) Tj T*
(  FROM `phase_splitter` ps) Tj T*
