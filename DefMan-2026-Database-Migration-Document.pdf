(-- =============================================================================) Tj T*
(-- File: 01_schema_3nf.sql) Tj T*
(-- Description: Target 3NF Relational Schema for DefMan-2026 \(MySQL 8.0+ / MariaDB 10.6+\)) Tj T*
(-- Engine: InnoDB | Charset: utf8mb4 | Collation: utf8mb4_unicode_ci) Tj T*
(-- =============================================================================) Tj T*
() Tj T*
(SET NAMES utf8mb4;) Tj T*
(SET FOREIGN_KEY_CHECKS = 0;) Tj T*
(SET SQL_MODE = 'STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_E) Tj T*
(    NGINE_SUBSTITUTION';) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 1. Table: `products` \(standardized from `product`\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE IF NOT EXISTS `products` \() Tj T*
(  `id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `name` VARCHAR\(100\) NOT NULL,) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_products_name` \(`name`\)) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 2. Table: `companies` \(extracted from `users.company` -- 3NF\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE IF NOT EXISTS `companies` \() Tj T*
(  `id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `name` VARCHAR\(100\) NOT NULL,) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_companies_name` \(`name`\)) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
