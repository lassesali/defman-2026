(-- 1. Migrate `product` -> `products` and backfill uncataloged `raport.Product`) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(INSERT INTO `products` \(`id`, `name`, `created_at`\)) Tj T*
(SELECT) Tj T*
(  p.`id`,) Tj T*
(  TRIM\(p.`name`\),) Tj T*
(  p.`created_at`) Tj T*
(FROM `product` p) Tj T*
(ON DUPLICATE KEY UPDATE) Tj T*
(  `name` = VALUES\(`name`\);) Tj T*
