(-- =============================================================================) Tj T*
(-- DefMan \(Defect Manager\) -- Modernized MySQL 8.0+ 3NF DDL Schema) Tj T*
(-- Normalized to Third Normal Form \(3NF\) with Backward-Compatibility Views) Tj T*
(-- Engine: InnoDB | Charset: utf8mb4 | Collation: utf8mb4_unicode_ci) Tj T*
(-- =============================================================================) Tj T*
() Tj T*
(SET NAMES utf8mb4;) Tj T*
(SET FOREIGN_KEY_CHECKS = 0;) Tj T*
(SET SQL_MODE = 'STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_E) Tj T*
(    NGINE_SUBSTITUTION';) Tj T*
() Tj T*
(-- Drop legacy views/tables if re-initializing) Tj T*
(DROP VIEW IF EXISTS `analyse`;) Tj T*
(DROP VIEW IF EXISTS `raport`;) Tj T*
(DROP VIEW IF EXISTS `product`;) Tj T*
() Tj T*
(DROP TABLE IF EXISTS `analysis_phases`;) Tj T*
(DROP TABLE IF EXISTS `defect_analyses`;) Tj T*
(DROP TABLE IF EXISTS `defect_reports`;) Tj T*
(DROP TABLE IF EXISTS `fault_classifications`;) Tj T*
(DROP TABLE IF EXISTS `sdlc_phases`;) Tj T*
(DROP TABLE IF EXISTS `password_resets`;) Tj T*
(DROP TABLE IF EXISTS `user_sessions`;) Tj T*
(DROP TABLE IF EXISTS `users`;) Tj T*
(DROP TABLE IF EXISTS `companies`;) Tj T*
(DROP TABLE IF EXISTS `products`;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 1. Table: `products`) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE `products` \() Tj T*
(  `id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `name` VARCHAR\(100\) NOT NULL,) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_products_name` \(`name`\)) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 2. Table: `companies` \(3NF lookup table extracted from `users`\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE `companies` \() Tj T*
(  `id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `name` VARCHAR\(100\) NOT NULL,) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_companies_name` \(`name`\)) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 3. Table: `users`) Tj T*
(-- User Levels:) Tj T*
