(-- -----------------------------------------------------------------------------) Tj T*
(-- 6. Migrate `analyse` -> `defect_analyses`) Tj T*
(--    - Standardizes `priority` \('most urgent' -> 'most_urgent', 'less urgent' -> 'less_urgent'\)) Tj T*
(--    - Standardizes `uniqueness` \('New defect' -> 'new', 'Already submitted' -> 'duplicate'\)) Tj T*
(--    - Preserves legacy `uniqueness = 'Critical'` by setting `severity = 'critical'` and `uniqu) Tj T*
(    eness = 'new'`) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(INSERT INTO `defect_analyses` \() Tj T*
(  `report_id`,) Tj T*
(  `developer_description`,) Tj T*
(  `classification_id`,) Tj T*
(  `date_originated`,) Tj T*
(  `activity_originated`,) Tj T*
(  `deliverable`,) Tj T*
(  `what_to_do`,) Tj T*
(  `assigned_on`,) Tj T*
(  `uniqueness`,) Tj T*
(  `duplicate_of_report_id`,) Tj T*
(  `priority`,) Tj T*
(  `severity`,) Tj T*
(  `workaround`,) Tj T*
(  `proposed_fix`,) Tj T*
(  `status`,) Tj T*
(  `fix_description`,) Tj T*
(  `fix_started_on`,) Tj T*
(  `fix_completed_on`,) Tj T*
(  `fix_impact`,) Tj T*
(  `fix_effort`,) Tj T*
(  `fix_cost`,) Tj T*
(  `resolution_description`,) Tj T*
(  `resolution_completed_on`,) Tj T*
(  `resolution_closed_on`,) Tj T*
(  `cost_of_defect`,) Tj T*
(  `activity_found`) Tj T*
(\)) Tj T*
(SELECT) Tj T*
(  a.`id` AS `report_id`,) Tj T*
(  a.`devdesc` AS `developer_description`,) Tj T*
(  fc.`id` AS `classification_id`,) Tj T*
(  a.`dateoriginated` AS `date_originated`,) Tj T*
(  a.`actoriginated` AS `activity_originated`,) Tj T*
(  a.`deliverable` AS `deliverable`,) Tj T*
(  a.`whattodo` AS `what_to_do`,) Tj T*
(  a.`assigned` AS `assigned_on`,) Tj T*
(  CASE a.`uniqueness`) Tj T*
(    WHEN 'Already submitted' THEN 'duplicate') Tj T*
(    WHEN 'New defect'        THEN 'new') Tj T*
(    WHEN 'Critical'          THEN 'new') Tj T*
(    ELSE 'new') Tj T*
(  END AS `uniqueness`,) Tj T*
(  NULL AS `duplicate_of_report_id`,) Tj T*
(  CASE a.`priority`) Tj T*
(    WHEN 'most urgent' THEN 'most_urgent') Tj T*
(    WHEN 'average'     THEN 'average') Tj T*
(    WHEN 'less urgent' THEN 'less_urgent') Tj T*
(    ELSE 'average') Tj T*
(  END AS `priority`,) Tj T*
(  CASE) Tj T*
(    WHEN a.`uniqueness` = 'Critical' THEN 'critical') Tj T*
(    ELSE a.`severity`) Tj T*
(  END AS `severity`,) Tj T*
(  a.`workaround` AS `workaround`,) Tj T*
(  a.`proposedfix` AS `proposed_fix`,) Tj T*
(  a.`status` AS `status`,) Tj T*
(  a.`fixdesc` AS `fix_description`,) Tj T*
ET
endstream
