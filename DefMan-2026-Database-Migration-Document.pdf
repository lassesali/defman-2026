(-- 8. Table: `defect_reports` \(standardized & normalized from `raport`\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE IF NOT EXISTS `defect_reports` \() Tj T*
(  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `product_id` SMALLINT UNSIGNED NOT NULL,) Tj T*
(  `environment` TEXT NULL DEFAULT NULL,) Tj T*
(  `reporter_user_id` SMALLINT UNSIGNED NULL DEFAULT NULL,) Tj T*
(  `guest_name` VARCHAR\(100\) NULL DEFAULT NULL,) Tj T*
(  `guest_email` VARCHAR\(255\) NULL DEFAULT NULL,) Tj T*
(  `reported_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  `title` VARCHAR\(255\) NOT NULL,) Tj T*
(  `description` TEXT NOT NULL,) Tj T*
(  `discovered_by` VARCHAR\(100\) NULL DEFAULT NULL,) Tj T*
(  `person_type` ENUM\('Customer', 'Developer', 'Tester'\) NOT NULL DEFAULT 'Customer',) Tj T*
(  `occurred_on` DATE NOT NULL,) Tj T*
