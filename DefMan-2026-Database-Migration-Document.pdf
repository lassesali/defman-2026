(-- -----------------------------------------------------------------------------) Tj T*
(-- 8. Table: `defect_reports` \(3NF normalized defect reports\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE `defect_reports` \() Tj T*
(  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `product_id` SMALLINT UNSIGNED NOT NULL,) Tj T*
(  `environment` TEXT NULL DEFAULT NULL,) Tj T*
(  `reporter_user_id` SMALLINT UNSIGNED NULL DEFAULT NULL,) Tj T*
(  `guest_name` VARCHAR\(100\) NULL DEFAULT NULL,) Tj T*
(  `guest_email` VARCHAR\(255\) NULL DEFAULT NULL,) Tj T*
(  `reported_at` DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  `title` VARCHAR\(255\) NOT NULL,) Tj T*
(  `description` TEXT NOT NULL,) Tj T*
(  `discovered_by` VARCHAR\(100\) NULL DEFAULT NULL,) Tj T*
(  `person_type` ENUM\('Customer', 'Developer', 'Tester'\) NOT NULL DEFAULT 'Customer',) Tj T*
(  `occurred_on` DATE NOT NULL,) Tj T*
(  `location` VARCHAR\(255\) NULL DEFAULT NULL,) Tj T*
(  `initial_severity` ENUM\('minor', 'major', 'critical'\) NOT NULL DEFAULT 'minor',) Tj T*
(  `initial_priority` ENUM\('most_urgent', 'average', 'less_urgent'\) NOT NULL DEFAULT 'average',) Tj T*
(  `additional_info` TEXT NULL DEFAULT NULL,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  KEY `idx_defect_reports_product_id` \(`product_id`\),) Tj T*
(  KEY `idx_defect_reports_reporter_user_id` \(`reporter_user_id`\),) Tj T*
(  KEY `idx_defect_reports_reported_at` \(`reported_at` DESC\),) Tj T*
(  KEY `idx_defect_reports_severity_reported` \(`initial_severity`, `reported_at` DESC\),) Tj T*
(  KEY `idx_defect_reports_priority_reported` \(`initial_priority`, `reported_at` DESC\),) Tj T*
(  CONSTRAINT `fk_defect_reports_product`) Tj T*
(    FOREIGN KEY \(`product_id`\) REFERENCES `products` \(`id`\)) Tj T*
(    ON DELETE RESTRICT ON UPDATE CASCADE,) Tj T*
(  CONSTRAINT `fk_defect_reports_reporter`) Tj T*
(    FOREIGN KEY \(`reporter_user_id`\) REFERENCES `users` \(`id`\)) Tj T*
(    ON DELETE SET NULL ON UPDATE CASCADE,) Tj T*
(  CONSTRAINT `chk_defect_reports_reporter_identity`) Tj T*
(    CHECK \() Tj T*
(      `reporter_user_id` IS NOT NULL) Tj T*
(      OR \(`guest_name` IS NOT NULL AND `guest_email` IS NOT NULL\)) Tj T*
(    \)) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 9. Table: `defect_analyses` \(3NF normalized 1:1 extension of `defect_reports`\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE `defect_analyses` \() Tj T*
