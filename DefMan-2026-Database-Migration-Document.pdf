(--   0 = Applying \(Pending Admin Approval - form_apply.php\)) Tj T*
(--   1 = Public   \(Unauthenticated / Public reporter - form_raportpub.php\)) Tj T*
(--   2 = Customer \(Authenticated defect reporter - form_raport.php\)) Tj T*
(--   3 = Analyzer \(Developer / QA triage & IEEE fault cost tracking - form_analyze.php\)) Tj T*
(--   4 = Admin    \(Full system access, user approval & product CRUD - form_usermanagement.php\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE `users` \() Tj T*
(  `id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `login` VARCHAR\(64\) NOT NULL COMMENT 'Legacy max 6 chars in 2004 UI; widened for modern auth',) Tj T*
(  `password` VARCHAR\(255\) NOT NULL COMMENT 'Argon2id password hash \(PASSWORD_ARGON2ID\)',) Tj T*
(  `email` VARCHAR\(255\) NOT NULL,) Tj T*
(  `userlevel` TINYINT UNSIGNED NOT NULL DEFAULT 0 COMMENT '0=Applying, 1=Public, 2=Customer, 3=A) Tj T*
(    nalyzer, 4=Admin',) Tj T*
(  `company_id` SMALLINT UNSIGNED NULL DEFAULT NULL,) Tj T*
(  `phone` VARCHAR\(50\) NULL DEFAULT NULL,) Tj T*
(  `name` VARCHAR\(100\) NULL DEFAULT NULL,) Tj T*
(  `activate` TINYINT\(1\) NOT NULL DEFAULT 0 COMMENT '0=Pending/Inactive, 1=Active',) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_users_login` \(`login`\),) Tj T*
(  UNIQUE KEY `uk_users_email` \(`email`\),) Tj T*
(  KEY `idx_users_company_id` \(`company_id`\),) Tj T*
(  KEY `idx_users_level_activate` \(`userlevel`, `activate`\),) Tj T*
(  CONSTRAINT `fk_users_company`) Tj T*
(    FOREIGN KEY \(`company_id`\) REFERENCES `companies` \(`id`\)) Tj T*
(    ON DELETE SET NULL ON UPDATE CASCADE) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 4. Table: `user_sessions` \(Cryptographically secure bearer/session tokens\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE `user_sessions` \() Tj T*
(  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `user_id` SMALLINT UNSIGNED NOT NULL,) Tj T*
(  `token_hash` CHAR\(64\) NOT NULL COMMENT 'SHA-256 hash of 256-bit random_bytes token',) Tj T*
(  `ip_address` VARCHAR\(45\) NULL DEFAULT NULL,) Tj T*
(  `user_agent` VARCHAR\(255\) NULL DEFAULT NULL,) Tj T*
(  `expires_at` DATETIME NOT NULL,) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_user_sessions_token_hash` \(`token_hash`\),) Tj T*
(  KEY `idx_user_sessions_user_expires` \(`user_id`, `expires_at`\),) Tj T*
(  KEY `idx_user_sessions_expires_at` \(`expires_at`\),) Tj T*
(  CONSTRAINT `fk_user_sessions_user`) Tj T*
(    FOREIGN KEY \(`user_id`\) REFERENCES `users` \(`id`\)) Tj T*
(    ON DELETE CASCADE ON UPDATE CASCADE) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 5. Table: `password_resets` \(Decoupled password recovery tokens -- 3NF\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE `password_resets` \() Tj T*
(  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `user_id` SMALLINT UNSIGNED NOT NULL,) Tj T*
(  `token_hash` CHAR\(64\) NOT NULL COMMENT 'SHA-256 hash of random_bytes\(32\) recovery token',) Tj T*
(  `expires_at` DATETIME NOT NULL,) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_password_resets_token_hash` \(`token_hash`\),) Tj T*
(  KEY `idx_password_resets_user_expires` \(`user_id`, `expires_at`\),) Tj T*
(  CONSTRAINT `fk_password_resets_user`) Tj T*
(    FOREIGN KEY \(`user_id`\) REFERENCES `users` \(`id`\)) Tj T*
(    ON DELETE CASCADE ON UPDATE CASCADE) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
ET
endstream
