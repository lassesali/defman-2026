(--------------------------------------------------------------------------------) Tj T*
(1.3 Legacy-to-3NF Schema Mapping Matrix) Tj T*
(--------------------------------------------------------------------------------) Tj T*
(Legacy Table.Column              -> Target 3NF Table.Column \(Type / Constraint\)) Tj T*
(--------------------------------------------------------------------------------) Tj T*
(product.id                       -> products.id \(SMALLINT UNSIGNED PK\)) Tj T*
(product.name                     -> products.name \(VARCHAR\(100\) UK NOT NULL\)) Tj T*
(users.company                    -> companies.name + users.company_id \(FK\)) Tj T*
(users.logged                     -> Derived via EXISTS\(user_sessions.expires_at > NOW\(\)\)) Tj T*
(users.reset_token_hash           -> password_resets.token_hash \(CHAR\(64\) UK\)) Tj T*
(users.reset_token_expires_at     -> password_resets.expires_at \(DATETIME\)) Tj T*
(raport.ID                        -> defect_reports.id \(INT UNSIGNED PK\)) Tj T*
(raport.Product + product_id      -> defect_reports.product_id \(SMALLINT UNSIGNED NOT NULL FK\)) Tj T*
(raport.Environment               -> defect_reports.environment \(TEXT NULL\)) Tj T*
(raport.CustomerID                -> defect_reports.reporter_user_id \(SMALLINT UNSIGNED NULL FK\)) Tj T*
(raport.Who                       -> users.login \(if user\) OR defect_reports.guest_name) Tj T*
(raport.Contactemail              -> users.email \(if user\) OR defect_reports.guest_email) Tj T*
(raport.Whenreported + Submitted  -> defect_reports.reported_at \(DATETIME NOT NULL\)) Tj T*
(raport.Title                     -> defect_reports.title \(VARCHAR\(255\) NOT NULL\)) Tj T*
(raport.Description               -> defect_reports.description \(TEXT NOT NULL\)) Tj T*
(raport.Discoveredby              -> defect_reports.discovered_by \(VARCHAR\(100\) NULL\)) Tj T*
(raport.Persontype                -> defect_reports.person_type \(ENUM\)) Tj T*
(raport.Occured                   -> defect_reports.occurred_on \(DATE NOT NULL\)) Tj T*
(raport.Location                  -> defect_reports.location \(VARCHAR\(255\) NULL\)) Tj T*
(raport.Severity                  -> defect_reports.initial_severity \(ENUM\)) Tj T*
(raport.Priority                  -> defect_reports.initial_priority \(ENUM: most_urgent/average/l) Tj T*
(    ess_urgent\)) Tj T*
(raport.Addinfo                   -> defect_reports.additional_info \(TEXT NULL\)) Tj T*
(analyse.id                       -> defect_analyses.report_id \(INT UNSIGNED PK, FK\)) Tj T*
(analyse.devdesc                  -> defect_analyses.developer_description \(TEXT NULL\)) Tj T*
(analyse.classification           -> fault_classifications.code + defect_analyses.classification_) Tj T*
(    id \(FK\)) Tj T*
(analyse.dateoriginated           -> defect_analyses.date_originated \(DATE NULL\)) Tj T*
(analyse.phase                    -> sdlc_phases.name + analysis_phases \(report_id, phase_id\)) Tj T*
(analyse.actoriginated            -> defect_analyses.activity_originated \(TEXT NULL\)) Tj T*
(analyse.deliverable              -> defect_analyses.deliverable \(VARCHAR\(255\) NULL\)) Tj T*
(analyse.whattodo                 -> defect_analyses.what_to_do \(TEXT NULL\)) Tj T*
(analyse.submitted                -> Removed \(derived from defect_reports.reported_at\)) Tj T*
(analyse.assigned                 -> defect_analyses.assigned_on \(DATE NULL\)) Tj T*
(analyse.uniqueness               -> defect_analyses.uniqueness \(ENUM: new/duplicate\)) Tj T*
(                                    + defect_analyses.duplicate_of_report_id \(FK\)) Tj T*
(analyse.priority                 -> defect_analyses.priority \(ENUM: most_urgent/average/less_urg) Tj T*
(    ent\)) Tj T*
(analyse.severity                 -> defect_analyses.severity \(ENUM: minor/major/critical\)) Tj T*
(analyse.workaround               -> defect_analyses.workaround \(TEXT NULL\)) Tj T*
(analyse.proposedfix              -> defect_analyses.proposed_fix \(TEXT NULL\)) Tj T*
ET
endstream
