(  }) Tj T*
(  return { color: 0x38bdf8, alpha: 0.45, width: 2 };) Tj T*
(}) Tj T*
() Tj T*
(function computeNodeRadiusFromEffort\() Tj T*
(  actualEffortHours: number,) Tj T*
(  mttrOrLeadHours: number) Tj T*
(\): number {) Tj T*
(  const effortComponent = Math.sqrt\(Math.max\(1, actualEffortHours\)\) * 6.5;) Tj T*
(  const flowComponent = Math.log10\(Math.max\(2, mttrOrLeadHours + 2\)\) * 5.5;) Tj T*
(  return Math.min\(54, Math.max\(22, Math.round\(14 + effortComponent + flowComponent\)\)\);) Tj T*
(}) Tj T*
