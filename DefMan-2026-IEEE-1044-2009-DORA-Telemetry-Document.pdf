(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 5. Table: `password_resets` \(decoupled from `users` -- 3NF\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE IF NOT EXISTS `password_resets` \() Tj T*
(  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `user_id` SMALLINT UNSIGNED NOT NULL,) Tj T*
(  `token_hash` CHAR\(64\) NOT NULL COMMENT 'SHA-256 hash of recovery token',) Tj T*
(  `expires_at` DATETIME NOT NULL,) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_password_resets_token_hash` \(`token_hash`\),) Tj T*
(  KEY `idx_password_resets_user_expires` \(`user_id`, `expires_at`\),) Tj T*
(  CONSTRAINT `fk_password_resets_user`) Tj T*
(    FOREIGN KEY \(`user_id`\) REFERENCES `users` \(`id`\)) Tj T*
(    ON DELETE CASCADE ON UPDATE CASCADE) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 6. Table: `sdlc_phases` \(lookup table for SDLC origin phases -- 1NF\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE IF NOT EXISTS `sdlc_phases` \() Tj T*
(  `id` TINYINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `name` VARCHAR\(64\) NOT NULL,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_sdlc_phases_name` \(`name`\)) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 7. Table: `fault_classifications` \(IEEE Std 1044-2009 anomaly classification -- 3NF\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE IF NOT EXISTS `fault_classifications` \() Tj T*
(  `id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `code` VARCHAR\(100\) NOT NULL,) Tj T*
(  `description` VARCHAR\(255\) NULL DEFAULT NULL,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_fault_classifications_code` \(`code`\)) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 8. Table: `defect_reports` \(standardized & normalized from `raport`\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE IF NOT EXISTS `defect_reports` \() Tj T*
(  `id` INT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `product_id` SMALLINT UNSIGNED NOT NULL,) Tj T*
(  `environment` TEXT NULL DEFAULT NULL,) Tj T*
(  `detected_environment` ENUM\('DEV', 'CI', 'STAGING', 'PROD'\) NOT NULL DEFAULT 'PROD',) Tj T*
