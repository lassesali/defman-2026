(    FOREIGN KEY \(`report_id`\) REFERENCES `defect_analyses` \(`report_id`\)) Tj T*
(    ON DELETE CASCADE ON UPDATE CASCADE,) Tj T*
(  CONSTRAINT `fk_analysis_phases_phase`) Tj T*
(    FOREIGN KEY \(`phase_id`\) REFERENCES `sdlc_phases` \(`id`\)) Tj T*
(    ON DELETE RESTRICT ON UPDATE CASCADE) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(SET FOREIGN_KEY_CHECKS = 1;) Tj T*
() Tj T*
(-- =============================================================================) Tj T*
(-- ATOMIC DML DATA MIGRATION \(START TRANSACTION ... COMMIT\)) Tj T*
(-- =============================================================================) Tj T*
(START TRANSACTION;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 1. Migrate `product` -> `products` and backfill uncataloged `raport.Product`) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(INSERT INTO `products` \(`id`, `name`, `created_at`\)) Tj T*
(SELECT) Tj T*
(  p.`id`,) Tj T*
(  TRIM\(p.`name`\),) Tj T*
(  p.`created_at`) Tj T*
(FROM `product` p) Tj T*
(ON DUPLICATE KEY UPDATE) Tj T*
(  `name` = VALUES\(`name`\);) Tj T*
() Tj T*
(INSERT IGNORE INTO `products` \(`name`\)) Tj T*
(SELECT DISTINCT) Tj T*
(  COALESCE\(NULLIF\(TRIM\(r.`Product`\), ''\), 'Unknown Product'\)) Tj T*
(FROM `raport` r) Tj T*
(LEFT JOIN `products` p) Tj T*
(  ON p.`name` = COALESCE\(NULLIF\(TRIM\(r.`Product`\), ''\), 'Unknown Product'\)) Tj T*
(WHERE p.`id` IS NULL;) Tj T*
() Tj T*
(-- Backfill NULL `raport.product_id` by matching `raport.Product = products.name`) Tj T*
(UPDATE `raport` r) Tj T*
(INNER JOIN `products` p) Tj T*
(  ON p.`name` = COALESCE\(NULLIF\(TRIM\(r.`Product`\), ''\), 'Unknown Product'\)) Tj T*
ET
endstream
endobj
