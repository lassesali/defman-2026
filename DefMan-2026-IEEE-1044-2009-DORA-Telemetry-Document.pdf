(  CONSTRAINT `fk_defect_analyses_report`) Tj T*
(    FOREIGN KEY \(`report_id`\) REFERENCES `defect_reports` \(`id`\)) Tj T*
(    ON DELETE CASCADE ON UPDATE CASCADE,) Tj T*
(  CONSTRAINT `fk_defect_analyses_classification`) Tj T*
(    FOREIGN KEY \(`classification_id`\) REFERENCES `fault_classifications` \(`id`\)) Tj T*
(    ON DELETE SET NULL ON UPDATE CASCADE,) Tj T*
(  CONSTRAINT `fk_defect_analyses_duplicate_of`) Tj T*
(    FOREIGN KEY \(`duplicate_of_report_id`\) REFERENCES `defect_reports` \(`id`\)) Tj T*
(    ON DELETE SET NULL ON UPDATE CASCADE) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 10. Table: `analysis_phases` \(1NF junction table for defect_analyses <-> sdlc_phases\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE `analysis_phases` \() Tj T*
(  `report_id` INT UNSIGNED NOT NULL,) Tj T*
