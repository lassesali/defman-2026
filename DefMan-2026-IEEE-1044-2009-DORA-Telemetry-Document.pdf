(-- -----------------------------------------------------------------------------) Tj T*
(-- 4. Table: `user_sessions` \(active rows derive user online status\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE IF NOT EXISTS `user_sessions` \() Tj T*
(  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `user_id` SMALLINT UNSIGNED NOT NULL,) Tj T*
(  `token_hash` CHAR\(64\) NOT NULL COMMENT 'SHA-256 hash of 256-bit random_bytes token',) Tj T*
(  `ip_address` VARCHAR\(45\) NULL DEFAULT NULL,) Tj T*
(  `user_agent` VARCHAR\(255\) NULL DEFAULT NULL,) Tj T*
(  `expires_at` DATETIME NOT NULL,) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_user_sessions_token_hash` \(`token_hash`\),) Tj T*
(  KEY `idx_user_sessions_user_expires` \(`user_id`, `expires_at`\),) Tj T*
