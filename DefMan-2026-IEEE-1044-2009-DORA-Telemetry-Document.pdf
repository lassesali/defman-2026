(  dr.`additional_info` AS `Addinfo`) Tj T*
(FROM `defect_reports` dr) Tj T*
(INNER JOIN `products` p) Tj T*
(  ON p.`id` = dr.`product_id`) Tj T*
(LEFT JOIN `users` u) Tj T*
(  ON u.`id` = dr.`reporter_user_id`;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 3. View: `analyse` \(reconstructs legacy `analyse` format from `defect_analyses`\)) Tj T*
(--    Maps IEEE 1044-2009 `root_cause_type`, `actual_effort_hours`, `triaged_at`,) Tj T*
(--    and `resolved_at` seamlessly back to legacy 2004 column aliases.) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE OR REPLACE VIEW `analyse` AS) Tj T*
(SELECT) Tj T*
(  da.`report_id` AS `id`,) Tj T*
(  da.`developer_description` AS `devdesc`,) Tj T*
(  COALESCE\(da.`root_cause_type`, fc.`code`\) AS `classification`,) Tj T*
(  da.`date_originated` AS `dateoriginated`,) Tj T*
(  ph.`phases_csv` AS `phase`,) Tj T*
(  da.`activity_originated` AS `actoriginated`,) Tj T*
(  da.`deliverable` AS `deliverable`,) Tj T*
(  da.`what_to_do` AS `whattodo`,) Tj T*
(  DATE\(dr.`reported_at`\) AS `submitted`,) Tj T*
(  COALESCE\(da.`assigned_on`, DATE\(da.`triaged_at`\)\) AS `assigned`,) Tj T*
(  CASE da.`uniqueness`) Tj T*
(    WHEN 'duplicate' THEN 'Already submitted') Tj T*
(    WHEN 'new'       THEN 'New defect') Tj T*
(  END AS `uniqueness`,) Tj T*
(  CASE da.`priority`) Tj T*
(    WHEN 'most_urgent' THEN 'most urgent') Tj T*
(    WHEN 'average'     THEN 'average') Tj T*
(    WHEN 'less_urgent' THEN 'less urgent') Tj T*
(  END AS `priority`,) Tj T*
(  da.`severity` AS `severity`,) Tj T*
(  da.`workaround` AS `workaround`,) Tj T*
(  da.`proposed_fix` AS `proposedfix`,) Tj T*
(  da.`status` AS `status`,) Tj T*
(  da.`fix_description` AS `fixdesc`,) Tj T*
(  da.`fix_started_on` AS `fixstarted`,) Tj T*
(  COALESCE\(da.`fix_completed_on`, DATE\(da.`resolved_at`\)\) AS `fixcomplete`,) Tj T*
(  da.`fix_impact` AS `fiximpact`,) Tj T*
(  COALESCE\(da.`actual_effort_hours`, da.`fix_effort`\) AS `fixeffort`,) Tj T*
(  da.`fix_cost` AS `fixcost`,) Tj T*
(  da.`resolution_description` AS `resodesc`,) Tj T*
(  COALESCE\(da.`resolution_completed_on`, DATE\(da.`resolved_at`\)\) AS `resocomplete`,) Tj T*
(  da.`resolution_closed_on` AS `resoclosed`,) Tj T*
(  da.`cost_of_defect` AS `costofdefect`,) Tj T*
(  da.`activity_found` AS `actfound`) Tj T*
(FROM `defect_analyses` da) Tj T*
(INNER JOIN `defect_reports` dr) Tj T*
(  ON dr.`id` = da.`report_id`) Tj T*
(LEFT JOIN `fault_classifications` fc) Tj T*
(  ON fc.`id` = da.`classification_id`) Tj T*
(LEFT JOIN \() Tj T*
(  SELECT) Tj T*
(    ap.`report_id`,) Tj T*
(    GROUP_CONCAT\(sp.`name` ORDER BY sp.`id` SEPARATOR ','\) AS `phases_csv`) Tj T*
(  FROM `analysis_phases` ap) Tj T*
(  INNER JOIN `sdlc_phases` sp) Tj T*
(    ON sp.`id` = ap.`phase_id`) Tj T*
(  GROUP BY ap.`report_id`) Tj T*
(\) ph) Tj T*
(  ON ph.`report_id` = da.`report_id`;) Tj T*
() Tj T*
() Tj T*
/F2 8 Tf (================================================================================) Tj /F1 8 Tf T*
ET
endstream
endobj
