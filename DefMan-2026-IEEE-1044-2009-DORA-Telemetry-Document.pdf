36 742 Td
(  CASE) Tj T*
(    WHEN r.`Persontype` = 'Developer' THEN 'DEV') Tj T*
(    WHEN r.`Persontype` = 'Tester'    THEN 'STAGING') Tj T*
(    ELSE 'PROD') Tj T*
(  END AS `detected_environment`,) Tj T*
(  CASE) Tj T*
(    WHEN r.`Title` LIKE '%Crash%' OR r.`Description` LIKE '%close%' THEN 'Application Crash) Tj T*
(    / Hang') Tj T*
(    WHEN r.`Title` LIKE '%Precision%' OR r.`Description` LIKE '%truncat%' THEN 'Incorrect) Tj T*
(    Calculation / Output') Tj T*
(    ELSE 'General Anomaly') Tj T*
(  END AS `symptom_category`,) Tj T*
(  FALSE AS `is_regression`,) Tj T*
(  u.`id` AS `reporter_user_id`,) Tj T*
(  CASE) Tj T*
(    WHEN u.`id` IS NOT NULL THEN NULL) Tj T*
(    ELSE COALESCE\(NULLIF\(TRIM\(r.`Who`\), ''\), 'Anonymous Guest'\)) Tj T*
(  END AS `guest_name`,) Tj T*
(  CASE) Tj T*
(    WHEN u.`id` IS NOT NULL THEN NULL) Tj T*
(    ELSE COALESCE\(NULLIF\(TRIM\(r.`Contactemail`\), ''\), 'unknown@example.invalid'\)) Tj T*
(  END AS `guest_email`,) Tj T*
(  COALESCE\() Tj T*
(    STR_TO_DATE\(TRIM\(r.`Whenreported`\), '%Y-%m-%d %H:%i:%s'\),) Tj T*
(    STR_TO_DATE\(TRIM\(r.`Whenreported`\), '%Y-%m-%d %H:%i'\),) Tj T*
(    STR_TO_DATE\(TRIM\(r.`Whenreported`\), '%Y-%m-%d'\),) Tj T*
(    CAST\(r.`Submitted` AS DATETIME\),) Tj T*
(    NOW\(\)) Tj T*
(  \) AS `reported_at`,) Tj T*
(  r.`Title` AS `title`,) Tj T*
(  r.`Description` AS `description`,) Tj T*
(  r.`Discoveredby` AS `discovered_by`,) Tj T*
(  r.`Persontype` AS `person_type`,) Tj T*
(  r.`Occured` AS `occurred_on`,) Tj T*
(  r.`Location` AS `location`,) Tj T*
(  r.`Severity` AS `initial_severity`,) Tj T*
(  CASE r.`Priority`) Tj T*
(    WHEN 'm_urgent' THEN 'most_urgent') Tj T*
(    WHEN 'average'  THEN 'average') Tj T*
(    WHEN 'l_urgent' THEN 'less_urgent') Tj T*
(    ELSE 'average') Tj T*
(  END AS `initial_priority`,) Tj T*
(  r.`Addinfo` AS `additional_info`) Tj T*
(FROM `raport` r) Tj T*
(LEFT JOIN `products` p_id) Tj T*
(  ON p_id.`id` = r.`product_id`) Tj T*
(LEFT JOIN `products` p_name) Tj T*
(  ON p_name.`name` = COALESCE\(NULLIF\(TRIM\(r.`Product`\), ''\), 'Unknown Product'\)) Tj T*
(LEFT JOIN `users` u) Tj T*
(  ON u.`id` = r.`CustomerID`) Tj T*
(ON DUPLICATE KEY UPDATE) Tj T*
(  `product_id`           = VALUES\(`product_id`\),) Tj T*
(  `detected_environment` = VALUES\(`detected_environment`\),) Tj T*
(  `symptom_category`     = VALUES\(`symptom_category`\),) Tj T*
(  `reporter_user_id`     = VALUES\(`reporter_user_id`\),) Tj T*
(  `guest_name`           = VALUES\(`guest_name`\),) Tj T*
(  `guest_email`          = VALUES\(`guest_email`\),) Tj T*
(  `reported_at`          = VALUES\(`reported_at`\),) Tj T*
(  `initial_priority`     = VALUES\(`initial_priority`\);) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 5. Migrate `analyse.classification` -> `fault_classifications`) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(INSERT IGNORE INTO `fault_classifications` \(`code`\)) Tj T*
(SELECT DISTINCT) Tj T*
(  TRIM\(a.`classification`\)) Tj T*
ET
