stream
BT
/F2 8.5 Tf
36 762 Td (DefMan-2026 IEEE 1044-2009 & DORA Telemetry Document - Page 20 of 99) Tj
ET
0.75 w 36 755 m 576 755 l S
BT
/F1 8 Tf
10.5 TL
36 742 Td
(  `actual_effort_hours`  = VALUES\(`actual_effort_hours`\),) Tj T*
(  `triaged_at`           = VALUES\(`triaged_at`\),) Tj T*
(  `resolved_at`          = VALUES\(`resolved_at`\),) Tj T*
(  `uniqueness`           = VALUES\(`uniqueness`\),) Tj T*
(  `priority`             = VALUES\(`priority`\),) Tj T*
(  `severity`             = VALUES\(`severity`\);) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 7. Split comma-delimited `analyse.phase` into `sdlc_phases` and `analysis_phases`) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(INSERT IGNORE INTO `sdlc_phases` \(`name`\)) Tj T*
(WITH RECURSIVE `phase_splitter` \(`report_id`, `phase_token`, `remainder`\) AS \() Tj T*
(  SELECT) Tj T*
(    a.`id` AS `report_id`,) Tj T*
(    TRIM\(SUBSTRING_INDEX\(a.`phase`, ',', 1\)\) AS `phase_token`,) Tj T*
(    SUBSTRING\(a.`phase`, CHAR_LENGTH\(SUBSTRING_INDEX\(a.`phase`, ',', 1\)\) + 2\) AS `remainder`) Tj T*
(  FROM `analyse` a) Tj T*
(  WHERE a.`phase` IS NOT NULL) Tj T*
(    AND TRIM\(a.`phase`\) <> '') Tj T*
(  UNION ALL) Tj T*
(  SELECT) Tj T*
(    ps.`report_id`,) Tj T*
(    TRIM\(SUBSTRING_INDEX\(ps.`remainder`, ',', 1\)\) AS `phase_token`,) Tj T*
(    SUBSTRING\(ps.`remainder`, CHAR_LENGTH\(SUBSTRING_INDEX\(ps.`remainder`, ',', 1\)\) + 2\) AS) Tj T*
(    `remainder`) Tj T*
(  FROM `phase_splitter` ps) Tj T*
(  WHERE ps.`remainder` <> '') Tj T*
(\)) Tj T*
(SELECT DISTINCT) Tj T*
(  ps.`phase_token`) Tj T*
(FROM `phase_splitter` ps) Tj T*
(WHERE ps.`phase_token` <> '';) Tj T*
() Tj T*
(INSERT IGNORE INTO `analysis_phases` \(`report_id`, `phase_id`\)) Tj T*
(WITH RECURSIVE `phase_splitter` \(`report_id`, `phase_token`, `remainder`\) AS \() Tj T*
(  SELECT) Tj T*
(    a.`id` AS `report_id`,) Tj T*
(    TRIM\(SUBSTRING_INDEX\(a.`phase`, ',', 1\)\) AS `phase_token`,) Tj T*
(    SUBSTRING\(a.`phase`, CHAR_LENGTH\(SUBSTRING_INDEX\(a.`phase`, ',', 1\)\) + 2\) AS `remainder`) Tj T*
(  FROM `analyse` a) Tj T*
(  INNER JOIN `defect_analyses` da) Tj T*
(    ON da.`report_id` = a.`id`) Tj T*
(  WHERE a.`phase` IS NOT NULL) Tj T*
(    AND TRIM\(a.`phase`\) <> '') Tj T*
(  UNION ALL) Tj T*
(  SELECT) Tj T*
(    ps.`report_id`,) Tj T*
(    TRIM\(SUBSTRING_INDEX\(ps.`remainder`, ',', 1\)\) AS `phase_token`,) Tj T*
(    SUBSTRING\(ps.`remainder`, CHAR_LENGTH\(SUBSTRING_INDEX\(ps.`remainder`, ',', 1\)\) + 2\) AS) Tj T*
(    `remainder`) Tj T*
(  FROM `phase_splitter` ps) Tj T*
(  WHERE ps.`remainder` <> '') Tj T*
(\)) Tj T*
(SELECT) Tj T*
(  ps.`report_id`,) Tj T*
(  sp.`id` AS `phase_id`) Tj T*
(FROM `phase_splitter` ps) Tj T*
(INNER JOIN `sdlc_phases` sp) Tj T*
(  ON sp.`name` = ps.`phase_token`) Tj T*
(WHERE ps.`phase_token` <> '';) Tj T*
() Tj T*
(COMMIT;) Tj T*
() Tj T*
(-- =============================================================================) Tj T*
(-- POST-MIGRATION CLEANUP \(Drop denormalized columns & legacy tables\)) Tj T*
(-- =============================================================================) Tj T*
ET
endstream
