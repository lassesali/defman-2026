(function formatHoursMetric\(hours: number | null | undefined\): string {) Tj T*
(  if \(hours === null || hours === undefined || Number.isNaN\(Number\(hours\)\)\) {) Tj T*
(    return '--';) Tj T*
(  }) Tj T*
(  const numeric = Number\(hours\);) Tj T*
(  if \(numeric < 24\) {) Tj T*
(    return `${numeric.toFixed\(1\)}h`;) Tj T*
(  }) Tj T*
(  const days = \(numeric / 24\).toFixed\(1\);) Tj T*
(  return `${numeric.toFixed\(1\)}h \(${days}d\)`;) Tj T*
(}) Tj T*
() Tj T*
