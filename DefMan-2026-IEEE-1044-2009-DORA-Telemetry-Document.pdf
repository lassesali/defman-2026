(FROM `analyse` a) Tj T*
(WHERE a.`classification` IS NOT NULL) Tj T*
(  AND TRIM\(a.`classification`\) <> '';) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 6. Migrate `analyse` -> `defect_analyses`) Tj T*
(--    - Maps legacy 1992 classifications to IEEE Std 1044-2009 `root_cause_type`) Tj T*
(--      and `symptom_category`) Tj T*
(--    - Populates DORA timestamps \(`triaged_at`, `resolved_at`\), `actual_effort_hours`,) Tj T*
(--      `detected_environment`, and `is_regression`) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(INSERT INTO `defect_analyses` \() Tj T*
(  `report_id`,) Tj T*
(  `developer_description`,) Tj T*
(  `classification_id`,) Tj T*
(  `symptom_category`,) Tj T*
(  `root_cause_type`,) Tj T*
(  `detected_environment`,) Tj T*
(  `is_regression`,) Tj T*
(  `introducing_ref`,) Tj T*
(  `resolution_ref`,) Tj T*
(  `actual_effort_hours`,) Tj T*
(  `triaged_at`,) Tj T*
(  `resolved_at`,) Tj T*
(  `date_originated`,) Tj T*
(  `activity_originated`,) Tj T*
(  `deliverable`,) Tj T*
(  `what_to_do`,) Tj T*
(  `assigned_on`,) Tj T*
(  `uniqueness`,) Tj T*
(  `duplicate_of_report_id`,) Tj T*
(  `priority`,) Tj T*
(  `severity`,) Tj T*
(  `workaround`,) Tj T*
(  `proposed_fix`,) Tj T*
(  `status`,) Tj T*
(  `fix_description`,) Tj T*
(  `fix_started_on`,) Tj T*
(  `fix_completed_on`,) Tj T*
(  `fix_impact`,) Tj T*
(  `fix_effort`,) Tj T*
(  `fix_cost`,) Tj T*
(  `resolution_description`,) Tj T*
(  `resolution_completed_on`,) Tj T*
(  `resolution_closed_on`,) Tj T*
(  `cost_of_defect`,) Tj T*
(  `activity_found`) Tj T*
(\)) Tj T*
(SELECT) Tj T*
(  a.`id` AS `report_id`,) Tj T*
(  a.`devdesc` AS `developer_description`,) Tj T*
(  fc.`id` AS `classification_id`,) Tj T*
(  COALESCE\(dr.`symptom_category`, 'General Anomaly'\) AS `symptom_category`,) Tj T*
(  CASE TRIM\(COALESCE\(a.`classification`, 'Other'\)\)) Tj T*
(    WHEN 'Logic'                  THEN 'Code / Logic') Tj T*
(    WHEN 'Computational'          THEN 'Computational') Tj T*
(    WHEN 'Interface'              THEN 'Interface / Integration') Tj T*
(    WHEN 'Data handling'          THEN 'Data / Schema') Tj T*
(    WHEN 'Data'                   THEN 'Data / Schema') Tj T*
(    WHEN 'Documentation'          THEN 'Documentation') Tj T*
(    WHEN 'Document quality'       THEN 'Documentation') Tj T*
(    WHEN 'Enhancement'            THEN 'Requirements / Specification') Tj T*
(    WHEN 'Caused by a prev. Fix'  THEN 'Regression') Tj T*
(    WHEN 'Caused by a prev. fix'  THEN 'Regression') Tj T*
(    ELSE TRIM\(COALESCE\(a.`classification`, 'Other'\)\)) Tj T*
(  END AS `root_cause_type`,) Tj T*
ET
endstream
endobj
