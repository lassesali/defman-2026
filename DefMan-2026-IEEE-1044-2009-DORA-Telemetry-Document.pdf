(  WHERE TABLE_SCHEMA = DATABASE\(\)) Tj T*
(    AND TABLE_NAME = 'users') Tj T*
(    AND COLUMN_NAME = 'company_id') Tj T*
(\);) Tj T*
(SET @sql_add_company_id := IF\() Tj T*
(  @col_exists = 0,) Tj T*
(  'ALTER TABLE `users` ADD COLUMN `company_id` SMALLINT UNSIGNED NULL DEFAULT NULL AFTER) Tj T*
(    `userlevel`, ADD KEY `idx_users_company_id` \(`company_id`\), ADD CONSTRAINT) Tj T*
