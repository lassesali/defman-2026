0.75 w 36 755 m 576 755 l S
BT
/F1 8 Tf
10.5 TL
36 742 Td
(  dr.`detected_environment` AS `detected_environment`,) Tj T*
(  CASE) Tj T*
(    WHEN TRIM\(COALESCE\(a.`classification`, ''\)\) LIKE 'Caused by a prev%' THEN TRUE) Tj T*
(    ELSE FALSE) Tj T*
(  END AS `is_regression`,) Tj T*
(  NULL AS `introducing_ref`,) Tj T*
(  NULL AS `resolution_ref`,) Tj T*
(  a.`fixeffort` AS `actual_effort_hours`,) Tj T*
(  CASE) Tj T*
(    WHEN a.`assigned` IS NOT NULL THEN CAST\(CONCAT\(a.`assigned`, ' 10:00:00'\) AS DATETIME\)) Tj T*
(    ELSE NULL) Tj T*
(  END AS `triaged_at`,) Tj T*
(  CASE) Tj T*
(    WHEN a.`resocomplete` IS NOT NULL THEN CAST\(CONCAT\(a.`resocomplete`, ' 16:00:00'\) AS) Tj T*
(    DATETIME\)) Tj T*
(    WHEN a.`fixcomplete` IS NOT NULL  THEN CAST\(CONCAT\(a.`fixcomplete`, ' 16:00:00'\) AS) Tj T*
(    DATETIME\)) Tj T*
(    ELSE NULL) Tj T*
(  END AS `resolved_at`,) Tj T*
(  a.`dateoriginated` AS `date_originated`,) Tj T*
(  a.`actoriginated` AS `activity_originated`,) Tj T*
(  a.`deliverable` AS `deliverable`,) Tj T*
(  a.`whattodo` AS `what_to_do`,) Tj T*
(  a.`assigned` AS `assigned_on`,) Tj T*
(  CASE a.`uniqueness`) Tj T*
(    WHEN 'Already submitted' THEN 'duplicate') Tj T*
(    WHEN 'New defect'        THEN 'new') Tj T*
(    WHEN 'Critical'          THEN 'new') Tj T*
(    ELSE 'new') Tj T*
(  END AS `uniqueness`,) Tj T*
(  NULL AS `duplicate_of_report_id`,) Tj T*
(  CASE a.`priority`) Tj T*
(    WHEN 'most urgent' THEN 'most_urgent') Tj T*
(    WHEN 'average'     THEN 'average') Tj T*
(    WHEN 'less urgent' THEN 'less_urgent') Tj T*
(    ELSE 'average') Tj T*
(  END AS `priority`,) Tj T*
(  CASE) Tj T*
(    WHEN a.`uniqueness` = 'Critical' THEN 'critical') Tj T*
(    ELSE a.`severity`) Tj T*
(  END AS `severity`,) Tj T*
(  a.`workaround` AS `workaround`,) Tj T*
(  a.`proposedfix` AS `proposed_fix`,) Tj T*
(  a.`status` AS `status`,) Tj T*
(  a.`fixdesc` AS `fix_description`,) Tj T*
(  a.`fixstarted` AS `fix_started_on`,) Tj T*
(  a.`fixcomplete` AS `fix_completed_on`,) Tj T*
(  a.`fiximpact` AS `fix_impact`,) Tj T*
(  a.`fixeffort` AS `fix_effort`,) Tj T*
(  a.`fixcost` AS `fix_cost`,) Tj T*
(  a.`resodesc` AS `resolution_description`,) Tj T*
(  a.`resocomplete` AS `resolution_completed_on`,) Tj T*
(  a.`resoclosed` AS `resolution_closed_on`,) Tj T*
(  a.`costofdefect` AS `cost_of_defect`,) Tj T*
(  a.`actfound` AS `activity_found`) Tj T*
(FROM `analyse` a) Tj T*
(INNER JOIN `defect_reports` dr) Tj T*
(  ON dr.`id` = a.`id`) Tj T*
(LEFT JOIN `fault_classifications` fc) Tj T*
(  ON fc.`code` = TRIM\(a.`classification`\)) Tj T*
(ON DUPLICATE KEY UPDATE) Tj T*
(  `classification_id`    = VALUES\(`classification_id`\),) Tj T*
(  `symptom_category`     = VALUES\(`symptom_category`\),) Tj T*
(  `root_cause_type`      = VALUES\(`root_cause_type`\),) Tj T*
(  `detected_environment` = VALUES\(`detected_environment`\),) Tj T*
(  `is_regression`        = VALUES\(`is_regression`\),) Tj T*
ET
endstream
