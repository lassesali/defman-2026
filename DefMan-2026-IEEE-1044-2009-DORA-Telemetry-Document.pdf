(    SET NULL ON UPDATE CASCADE',) Tj T*
(  'SELECT 1') Tj T*
(\);) Tj T*
(PREPARE stmt FROM @sql_add_company_id;) Tj T*
(EXECUTE stmt;) Tj T*
(DEALLOCATE PREPARE stmt;) Tj T*
