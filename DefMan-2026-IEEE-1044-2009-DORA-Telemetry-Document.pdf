(    : IEEE_FAULT_HEX_COLORS[IeeeFaultType.OTHER];) Tj T*
(}) Tj T*
() Tj T*
(function getSeverityGlowColor\() Tj T*
(  severity: DefectSeverity | string,) Tj T*
(  priority: string,) Tj T*
(  isRegression: boolean) Tj T*
(\): {) Tj T*
(  color: number;) Tj T*
