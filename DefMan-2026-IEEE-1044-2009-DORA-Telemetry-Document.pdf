(-- =============================================================================) Tj T*
(-- File: 01_schema_3nf.sql) Tj T*
(-- Description: Target 3NF Relational Schema for DefMan-2026 \(MySQL 8.0+ / MariaDB 10.6+\)) Tj T*
(--              Includes IEEE Std 1044-2009 Anomaly Classification & DORA Telemetry) Tj T*
(-- Engine: InnoDB | Charset: utf8mb4 | Collation: utf8mb4_unicode_ci) Tj T*
(-- =============================================================================) Tj T*
() Tj T*
(SET NAMES utf8mb4;) Tj T*
(SET FOREIGN_KEY_CHECKS = 0;) Tj T*
(SET SQL_MODE = 'STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,) Tj T*
(    NO_ENGINE_SUBSTITUTION';) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 1. Table: `products` \(standardized from `product`\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE IF NOT EXISTS `products` \() Tj T*
(  `id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `name` VARCHAR\(100\) NOT NULL,) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_products_name` \(`name`\)) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 2. Table: `companies` \(extracted from `users.company` -- 3NF\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE IF NOT EXISTS `companies` \() Tj T*
(  `id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `name` VARCHAR\(100\) NOT NULL,) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_companies_name` \(`name`\)) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(-- 3. Table: `users` \(normalized: `company_id` FK; removed `logged` & reset cols\)) Tj T*
(-- User Levels:) Tj T*
(--   0 = Applying \(Pending Admin Approval\)) Tj T*
(--   1 = Public   \(Unauthenticated / Public reporter\)) Tj T*
(--   2 = Customer \(Authenticated defect reporter\)) Tj T*
(--   3 = Analyzer \(Developer / QA triage & IEEE 1044-2009 / DORA telemetry\)) Tj T*
(--   4 = Admin    \(Full system access, user approval & product CRUD\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE IF NOT EXISTS `users` \() Tj T*
(  `id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `login` VARCHAR\(64\) NOT NULL,) Tj T*
(  `password` VARCHAR\(255\) NOT NULL COMMENT 'Argon2id password hash \(PASSWORD_ARGON2ID\)',) Tj T*
(  `email` VARCHAR\(255\) NOT NULL,) Tj T*
(  `userlevel` TINYINT UNSIGNED NOT NULL DEFAULT 0 COMMENT '0=Applying..4=Admin',) Tj T*
(  `company_id` SMALLINT UNSIGNED NULL DEFAULT NULL,) Tj T*
(  `phone` VARCHAR\(50\) NULL DEFAULT NULL,) Tj T*
(  `name` VARCHAR\(100\) NULL DEFAULT NULL,) Tj T*
(  `activate` TINYINT\(1\) NOT NULL DEFAULT 0 COMMENT '0=Pending/Inactive, 1=Active',) Tj T*
(  `created_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,) Tj T*
(  `updated_at` TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,) Tj T*
(  PRIMARY KEY \(`id`\),) Tj T*
(  UNIQUE KEY `uk_users_login` \(`login`\),) Tj T*
(  UNIQUE KEY `uk_users_email` \(`email`\),) Tj T*
(  KEY `idx_users_company_id` \(`company_id`\),) Tj T*
(  KEY `idx_users_level_activate` \(`userlevel`, `activate`\),) Tj T*
(  CONSTRAINT `fk_users_company`) Tj T*
(    FOREIGN KEY \(`company_id`\) REFERENCES `companies` \(`id`\)) Tj T*
(    ON DELETE SET NULL ON UPDATE CASCADE) Tj T*
(\) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;) Tj T*
() Tj T*
ET
endstream
endobj
