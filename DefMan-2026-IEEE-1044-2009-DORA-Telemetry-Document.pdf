(-- 3. Table: `users`) Tj T*
(-- User Levels:) Tj T*
(--   0 = Applying \(Pending Admin Approval - form_apply.php\)) Tj T*
(--   1 = Public   \(Unauthenticated / Public reporter - form_raportpub.php\)) Tj T*
(--   2 = Customer \(Authenticated defect reporter - form_raport.php\)) Tj T*
(--   3 = Analyzer \(Developer / QA triage & IEEE 1044-2009 / DORA telemetry -) Tj T*
(    form_analyze.php\)) Tj T*
(--   4 = Admin    \(Full system access, user approval & product CRUD -) Tj T*
(    form_usermanagement.php\)) Tj T*
(-- -----------------------------------------------------------------------------) Tj T*
(CREATE TABLE `users` \() Tj T*
(  `id` SMALLINT UNSIGNED NOT NULL AUTO_INCREMENT,) Tj T*
(  `login` VARCHAR\(64\) NOT NULL COMMENT 'Legacy max 6 chars in 2004 UI; widened for modern) Tj T*
(    auth',) Tj T*
(  `password` VARCHAR\(255\) NOT NULL COMMENT 'Argon2id password hash \(PASSWORD_ARGON2ID\)',) Tj T*
(  `email` VARCHAR\(255\) NOT NULL,) Tj T*
(  `userlevel` TINYINT UNSIGNED NOT NULL DEFAULT 0 COMMENT '0=Applying, 1=Public, 2=Customer,) Tj T*
(    3=Analyzer, 4=Admin',) Tj T*
(  `company_id` SMALLINT UNSIGNED NULL DEFAULT NULL,) Tj T*
