erDiagram
    companies ||--o{ users : "employs (ON DELETE SET NULL)"
    users ||--o{ user_sessions : "authenticates (ON DELETE CASCADE)"
    users ||--o{ password_resets : "requests (ON DELETE CASCADE)"
    users ||--o{ defect_reports : "reports (ON DELETE SET NULL)"
    products ||--o{ defect_reports : "categorizes (ON DELETE RESTRICT)"
    defect_reports ||--o| defect_analyses : "is analyzed by (1:1 ON DELETE CASCADE)"
    defect_reports ||--o{ defect_analyses : "is duplicated by (ON DELETE SET NULL)"
    fault_classifications ||--o{ defect_analyses : "classifies (ON DELETE SET NULL)"
    defect_analyses ||--o{ analysis_phases : "spans (ON DELETE CASCADE)"
    sdlc_phases ||--o{ analysis_phases : "defines (ON DELETE RESTRICT)"

    products {
        SMALLINT_UNSIGNED id PK "AUTO_INCREMENT"
        VARCHAR_100 name UK "NOT NULL (uk_products_name)"
        TIMESTAMP created_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }

    companies {
        SMALLINT_UNSIGNED id PK "AUTO_INCREMENT"
        VARCHAR_100 name UK "NOT NULL (uk_companies_name)"
        TIMESTAMP created_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }

    users {
        SMALLINT_UNSIGNED id PK "AUTO_INCREMENT"
        VARCHAR_64 login UK "NOT NULL (uk_users_login)"
        VARCHAR_255 password "NOT NULL (Argon2id hash)"
        VARCHAR_255 email UK "NOT NULL (uk_users_email)"
        TINYINT_UNSIGNED userlevel "NOT NULL DEFAULT 0 (0=Applying..4=Admin)"
        SMALLINT_UNSIGNED company_id FK "NULL -> companies.id"
        VARCHAR_50 phone "NULL"
        VARCHAR_100 name "NULL"
        TINYINT_1 activate "NOT NULL DEFAULT 0"
        TIMESTAMP created_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
        TIMESTAMP updated_at "NOT NULL ON UPDATE CURRENT_TIMESTAMP"
    }

    user_sessions {
        BIGINT_UNSIGNED id PK "AUTO_INCREMENT"
        SMALLINT_UNSIGNED user_id FK "NOT NULL -> users.id"
        CHAR_64 token_hash UK "NOT NULL (uk_user_sessions_token_hash)"
        VARCHAR_45 ip_address "NULL"
        VARCHAR_255 user_agent "NULL"
        DATETIME expires_at "NOT NULL"
        TIMESTAMP created_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }

    password_resets {
        INT_UNSIGNED id PK "AUTO_INCREMENT"
        SMALLINT_UNSIGNED user_id FK "NOT NULL -> users.id"
        CHAR_64 token_hash UK "NOT NULL (uk_password_resets_token_hash)"
        DATETIME expires_at "NOT NULL"
        TIMESTAMP created_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
    }

    sdlc_phases {
        TINYINT_UNSIGNED id PK "AUTO_INCREMENT"
        VARCHAR_64 name UK "NOT NULL (uk_sdlc_phases_name)"
    }

    fault_classifications {
        SMALLINT_UNSIGNED id PK "AUTO_INCREMENT"
        VARCHAR_100 code UK "NOT NULL (IEEE 1044-1992)"
        VARCHAR_255 description "NULL"
    }

    defect_reports {
        INT_UNSIGNED id PK "AUTO_INCREMENT"
        SMALLINT_UNSIGNED product_id FK "NOT NULL -> products.id"
        TEXT environment "NULL"
        SMALLINT_UNSIGNED reporter_user_id FK "NULL -> users.id"
        VARCHAR_100 guest_name "NULL"
        VARCHAR_255 guest_email "NULL"
        DATETIME reported_at "NOT NULL DEFAULT CURRENT_TIMESTAMP"
        VARCHAR_255 title "NOT NULL"
        TEXT description "NOT NULL"
        VARCHAR_100 discovered_by "NULL"
        ENUM person_type "NOT NULL ('Customer','Developer','Tester')"
        DATE occurred_on "NOT NULL"
        VARCHAR_255 location "NULL"
        ENUM initial_severity "NOT NULL ('minor','major','critical')"
        ENUM initial_priority "NOT NULL ('most_urgent','average','less_urgent')"
        TEXT additional_info "NULL"
    }

    defect_analyses {
        INT_UNSIGNED report_id PK,FK "NOT NULL -> defect_reports.id"
        TEXT developer_description "NULL"
        SMALLINT_UNSIGNED classification_id FK "NULL -> fault_classifications.id"
        DATE date_originated "NULL"
        TEXT activity_originated "NULL"
        VARCHAR_255 deliverable "NULL"
        TEXT what_to_do "NULL"
        DATE assigned_on "NULL"
        ENUM uniqueness "NOT NULL ('new','duplicate')"
        INT_UNSIGNED duplicate_of_report_id FK "NULL -> defect_reports.id"
        ENUM priority "NOT NULL ('most_urgent','average','less_urgent')"
        ENUM severity "NOT NULL ('minor','major','critical')"
        TEXT workaround "NULL"
        TEXT proposed_fix "NULL"
        ENUM status "NOT NULL ('submitted'..'closed')"
        TEXT fix_description "NULL"
        DATE fix_started_on "NULL"
        DATE fix_completed_on "NULL"
        TEXT fix_impact "NULL"
        DECIMAL_8_2_UNSIGNED fix_effort "NULL (hours)"
        DECIMAL_10_2_UNSIGNED fix_cost "NULL (EUR)"
        TEXT resolution_description "NULL"
        DATE resolution_completed_on "NULL"
        DATE resolution_closed_on "NULL"
        DECIMAL_10_2_UNSIGNED cost_of_defect "NULL (EUR)"
        TEXT activity_found "NULL"
    }

    analysis_phases {
        INT_UNSIGNED report_id PK,FK "NOT NULL -> defect_analyses.report_id"
        TINYINT_UNSIGNED phase_id PK,FK "NOT NULL -> sdlc_phases.id"
    }
