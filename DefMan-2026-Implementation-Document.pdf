(  `CustomerID` SMALLINT UNSIGNED DEFAULT NULL,) Tj T*
(  `Who` VARCHAR\(64\) NOT NULL,) Tj T*
(  `Contactemail` VARCHAR\(255\) NOT NULL,) Tj T*
