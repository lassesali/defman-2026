(/**) Tj T*
( * RBAC Authentication & Authorization Middleware) Tj T*
( * Enforces the 4 DefMan user levels:) Tj T*
( *   - Level 1 \(Public\):   Unauthenticated / public defect submission) Tj T*
( *   - Level 2 \(Customer\): Authenticated user tracking their own submitted defects) Tj T*
( *   - Level 3 \(Analyzer\): Developer/QA triage, IEEE fault classification, fix & cost tracking) Tj T*
( *   - Level 4 \(Admin\):    User registration approval queue, role assignment, product management) Tj T*
( */) Tj T*
(final readonly class RbacMiddleware) Tj T*
({) Tj T*
(    public function __construct\(private UserRepository $userRepository\) {}) Tj T*
() Tj T*
(    public function extractBearerToken\(\): ?string) Tj T*
(    {) Tj T*
(        $header = $_SERVER['HTTP_AUTHORIZATION'] ?? $_SERVER['REDIRECT_HTTP_AUTHORIZATION'] ?? ') Tj T*
(    ';) Tj T*
(        if \(preg_match\('/^Bearer\\s+\([a-f0-9]{64}\)$/i', $header, $matches\)\) {) Tj T*
(            return $matches[1];) Tj T*
(        }) Tj T*
(        return $_COOKIE['defman_token'] ?? null;) Tj T*
(    }) Tj T*
() Tj T*
(    public function authenticateOptional\(\): ?array) Tj T*
(    {) Tj T*
(        $token = $this->extractBearerToken\(\);) Tj T*
(        if \($token === null\) {) Tj T*
(            return null;) Tj T*
(        }) Tj T*
(        return $this->userRepository->findUserBySessionToken\($token\);) Tj T*
(    }) Tj T*
() Tj T*
(    public function requireLevel\(UserLevel $minimumLevel\): array) Tj T*
(    {) Tj T*
(        if \($minimumLevel === UserLevel::PUBLIC\) {) Tj T*
(            return $this->authenticateOptional\(\) ?? [) Tj T*
(                'id'        => null,) Tj T*
(                'login'     => 'public',) Tj T*
(                'userlevel' => UserLevel::PUBLIC->value,) Tj T*
(            ];) Tj T*
(        }) Tj T*
() Tj T*
(        $user = $this->authenticateOptional\(\);) Tj T*
(        if \($user === null\) {) Tj T*
(            http_response_code\(401\);) Tj T*
(            header\('Content-Type: application/json'\);) Tj T*
(            echo json_encode\(['error' => 'Authentication required.']\);) Tj T*
(            exit;) Tj T*
(        }) Tj T*
() Tj T*
(        $userLevel = \(int\) $user['userlevel'];) Tj T*
ET
